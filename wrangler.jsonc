{
  "name": "saanjh-studio",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "saanjh-images" }],
  "observability": { "enabled": true }
}
